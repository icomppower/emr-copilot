LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MODEL_PLANNER=claude-haiku-5-5
LLM_MODEL_WORKER=claude-haiku-5-5
LLM_MODEL_VERIFIER=claude-haiku-5-5
